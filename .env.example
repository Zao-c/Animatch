DATABASE_URL="postgresql://animatch:animatch_password@localhost:5432/animatch?schema=public"
FRIEND_INVITE_CODE="33989"
AUTH_SECRET="replace-with-long-random-secret"
AUTH_COOKIE_SECURE="false"
SITE_ADMIN_USER_IDS=
SITE_ADMIN_CODE=

# Optional Tencent COS cover cache. When configured, imported remote covers are
# copied to COS and served directly from COS/CDN instead of through the app.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=
COS_COVER_PREFIX=animatch/covers
COS_OBJECT_ACL=public-read

# Comma-separated public image hosts that should bypass /api/image-proxy.
# Use this for a custom COS/CDN domain, for example: img.example.com
NEXT_PUBLIC_DIRECT_IMAGE_HOSTS=

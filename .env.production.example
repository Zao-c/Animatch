POSTGRES_USER=animatch
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=animatch
DATABASE_URL=postgresql://animatch:change_this_strong_password@postgres:5432/animatch?schema=public
FRIEND_INVITE_CODE=33989
AUTH_SECRET=replace-with-long-random-secret
AUTH_COOKIE_SECURE=false
SITE_ADMIN_USER_IDS=
SITE_ADMIN_CODE=

# Optional Tencent COS cover cache. Keep secrets only on the server.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=
COS_COVER_PREFIX=animatch/covers
COS_OBJECT_ACL=public-read

# Comma-separated custom COS/CDN domains that browser images can request directly.
NEXT_PUBLIC_DIRECT_IMAGE_HOSTS=

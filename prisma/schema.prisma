generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum PoolStatus {
  DRAFT
  PUBLISHED
  LOCKED
  ARCHIVED
}

enum AnimeSourceType {
  BANGUMI
  MANAMI
  CUSTOM_UPLOAD
  MANUAL
  DEMO
  TIERMAKER_IMPORT
}

enum PersonalRunStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum PoolComparisonResult {
  LEFT_WIN
  RIGHT_WIN
  DRAW
  SKIP
  LEFT_UNSEEN
  RIGHT_UNSEEN
  BOTH_UNSEEN
}

enum PoolComparisonMode {
  NORMAL
  RECALIBRATE
  FOCUS_RECALIBRATE
  RANGE_RECALIBRATE
}

enum WatchStatus {
  UNKNOWN
  UNSEEN
  WATCHING
  WATCHED
  DROPPED
  INTERESTED
  NOT_INTERESTED
}

enum RecommendationFeedback {
  NONE
  INTERESTED
  NOT_INTERESTED
  WATCHED
  ADDED_TO_POOL
  DISMISSED
}

enum RecalibrationSessionType {
  SMART
  RANGE
  FOCUS
}

enum RecalibrationSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id                   String                 @id @default(cuid())
  email                String?                @unique
  name                 String?
  image                String?
  username             String?                @unique
  profileVisibility    Visibility             @default(PUBLIC)
  allowTasteMatching   Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  customPools          CustomPool[]           @relation("UserCustomPools")
  personalRuns         PersonalRun[]          @relation("UserPersonalRuns")
  poolScores           UserPoolScore[]        @relation("UserPoolScores")
  poolComparisons      PoolComparison[]       @relation("UserPoolComparisons")
  animeStatuses        UserAnimeStatus[]      @relation("UserAnimeStatuses")
  tierAdjustments      ManualTierAdjustment[] @relation("UserTierAdjustments")
  tagPreferences       UserTagPreference[]    @relation("UserTagPreferences")
  animeRecommendations AnimeRecommendation[]  @relation("UserAnimeRecommendations")
  similaritiesAsUserA  UserSimilarity[]       @relation("SimilarityUserA")
  similaritiesAsUserB  UserSimilarity[]       @relation("SimilarityUserB")
  battleSeasons        BattleSeason[]
  battleVotes          BattleVote[]
  battleSeasonScores   BattleSeasonUserScore[]
}

model Anime {
  id                   String                 @id @default(cuid())
  bgmId                Int?                   @unique
  title                String
  titleCn              String?
  titleJa              String?
  titleEn              String?
  summary              String?
  imageUrl             String?
  imageSmallUrl        String?
  imageMediumUrl       String?
  imageLargeUrl        String?
  thumbnailUrl         String?
  airDate              DateTime?
  bangumiRank          Int?
  bangumiScore         Float?
  bangumiVotes         Int?
  tags                 String[]
  aliases              String[]               @default([])
  year                 Int?
  season               String?
  animeType            String?
  episodes             Int?
  status               String?
  studios              String[]               @default([])
  externalLinks        String[]               @default([])
  source               AnimeSourceType        @default(BANGUMI)
  sourceId             String?
  rawJson              Json?
  fetchedAt            DateTime?
  imageStatus          String                 @default("UNKNOWN")
  imageCheckedAt       DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  poolEntries          PoolAnime[]            @relation("AnimePoolEntries")
  poolScores           UserPoolScore[]        @relation("AnimePoolScores")
  animeStatuses        UserAnimeStatus[]      @relation("AnimeStatuses")
  tierAdjustments      ManualTierAdjustment[] @relation("AnimeTierAdjustments")
  animeRecommendations AnimeRecommendation[]  @relation("AnimeRecommendations")
  leftComparisons      PoolComparison[]       @relation("LeftAnimeComparisons")
  rightComparisons     PoolComparison[]       @relation("RightAnimeComparisons")
  wonComparisons       PoolComparison[]       @relation("WinnerAnimeComparisons")
  lostComparisons      PoolComparison[]       @relation("LoserAnimeComparisons")
  battleSeasonScores   BattleSeasonUserScore[] @relation("AnimeBattleSeasonUserScores")
}

model CustomPool {
  id                  String                 @id @default(cuid())
  creatorId           String
  name                String
  description         String?
  coverUrl            String?
  visibility          Visibility             @default(PRIVATE)
  status              PoolStatus             @default(DRAFT)
  tags                String[]
  sourcePoolId        String?
  affectsGlobalTaste  Boolean                @default(true)
  allowPublicEdit     Boolean                @default(false)
  allowCommunityMatch Boolean                @default(false)
  isOfficialDemo      Boolean                @default(false)
  tierConfig          Json?
  cloneCount          Int                    @default(0)
  useCount            Int                    @default(0)
  likeCount           Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  publishedAt         DateTime?
  deletedAt           DateTime?
  creator             User                   @relation("UserCustomPools", fields: [creatorId], references: [id])
  sourcePool          CustomPool?            @relation("PoolClones", fields: [sourcePoolId], references: [id])
  clonedPools         CustomPool[]           @relation("PoolClones")
  poolAnime           PoolAnime[]            @relation("PoolAnimeEntries")
  personalRuns        PersonalRun[]          @relation("PoolPersonalRuns")
  poolScores          UserPoolScore[]        @relation("PoolScores")
  poolComparisons     PoolComparison[]       @relation("PoolComparisons")
  tierAdjustments     ManualTierAdjustment[] @relation("PoolTierAdjustments")
  tagPreferences      UserTagPreference[]    @relation("PoolTagPreferences")
  tierShares          TierShare[]            @relation("PoolTierShares")
  battleSeasons       BattleSeason[]
  battleSeasonScores  BattleSeasonUserScore[] @relation("PoolBattleSeasonUserScores")

  @@index([creatorId])
  @@index([status])
  @@index([visibility])
  @@index([isOfficialDemo])
  @@index([visibility, status])
}

model TierShare {
  id          String      @id @default(cuid())
  token       String      @unique
  poolId      String
  runId       String
  title       String
  description String?
  tierLabels  Json
  snapshot    Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  pool        CustomPool  @relation("PoolTierShares", fields: [poolId], references: [id])
  run         PersonalRun @relation("RunTierShares", fields: [runId], references: [id])

  @@index([poolId])
  @@index([runId])
  @@index([createdAt])
}

model PoolAnime {
  id                   String     @id @default(cuid())
  poolId               String
  animeId              String
  position             Int
  note                 String?
  initialElo           Float      @default(1500)
  displayTitleOverride String?
  coverUrlOverride     String?
  animeTypeOverride    String?
  tagsOverride         String[]   @default([])
  overrideNote         String?
  overrideUpdatedAt    DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  pool                 CustomPool @relation("PoolAnimeEntries", fields: [poolId], references: [id], onDelete: Cascade)
  anime                Anime      @relation("AnimePoolEntries", fields: [animeId], references: [id])

  @@unique([poolId, animeId])
  @@index([poolId])
  @@index([animeId])
}

model PersonalRun {
  id               String                 @id @default(cuid())
  userId           String
  poolId           String
  name             String                 @default("默认榜单")
  status           PersonalRunStatus      @default(ACTIVE)
  isDefault        Boolean                @default(true)
  algorithmVersion String                 @default("elo-v1")
  pairingVersion   String                 @default("active-v1")
  tierRuleVersion  String                 @default("percentile-v1")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  user             User                   @relation("UserPersonalRuns", fields: [userId], references: [id])
  pool             CustomPool             @relation("PoolPersonalRuns", fields: [poolId], references: [id])
  scores           UserPoolScore[]        @relation("RunPoolScores")
  comparisons      PoolComparison[]       @relation("RunComparisons")
  tierAdjustments  ManualTierAdjustment[] @relation("RunTierAdjustments")
  tagPreferences   UserTagPreference[]    @relation("RunTagPreferences")
  tierShares       TierShare[]            @relation("RunTierShares")

  @@index([userId, poolId])
  @@index([poolId])
}

model UserPoolScore {
  id             String      @id @default(cuid())
  userId         String
  poolId         String
  runId          String
  animeId        String
  eloScore       Float       @default(1500)
  uncertainty    Float       @default(350)
  compareCount   Int         @default(0)
  winCount       Int         @default(0)
  lossCount      Int         @default(0)
  drawCount      Int         @default(0)
  unseenCount    Int         @default(0)
  skipCount      Int         @default(0)
  isHidden       Boolean     @default(false)
  manualTier     String?
  manualRank     Int?
  manualLocked   Boolean     @default(false)
  lastComparedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation("UserPoolScores", fields: [userId], references: [id])
  pool           CustomPool  @relation("PoolScores", fields: [poolId], references: [id])
  run            PersonalRun @relation("RunPoolScores", fields: [runId], references: [id])
  anime          Anime       @relation("AnimePoolScores", fields: [animeId], references: [id])

  @@unique([userId, poolId, runId, animeId])
  @@index([userId, poolId, runId])
  @@index([animeId])
  @@index([poolId, runId])
}

model PoolComparison {
  id                 String               @id @default(cuid())
  userId             String
  poolId             String
  runId              String
  leftAnimeId        String
  rightAnimeId       String
  winnerAnimeId      String?
  loserAnimeId       String?
  result             PoolComparisonResult
  mode               PoolComparisonMode   @default(NORMAL)
  pairKey            String
  isEffective        Boolean              @default(true)
  leftSeen           Boolean?
  rightSeen          Boolean?
  leftEloBefore      Float?
  leftEloAfter       Float?
  rightEloBefore     Float?
  rightEloAfter      Float?
  leftPosition       Int?
  rightPosition      Int?
  leftKFactor        Float?
  rightKFactor       Float?
  expectedLeft       Float?
  expectedRight      Float?
  deltaLeft          Float?
  deltaRight         Float?
  leftScore10Before  Float?
  leftScore10After   Float?
  rightScore10Before Float?
  rightScore10After  Float?
  algorithmVersion   String               @default("elo-v1")
  pairingVersion     String               @default("active-v1")
  tierRuleVersion    String               @default("percentile-v1")
  clientMutationId   String
  undoneAt           DateTime?
  undoneByUserId     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation("UserPoolComparisons", fields: [userId], references: [id])
  pool               CustomPool           @relation("PoolComparisons", fields: [poolId], references: [id])
  run                PersonalRun          @relation("RunComparisons", fields: [runId], references: [id])
  leftAnime          Anime                @relation("LeftAnimeComparisons", fields: [leftAnimeId], references: [id])
  rightAnime         Anime                @relation("RightAnimeComparisons", fields: [rightAnimeId], references: [id])
  winnerAnime        Anime?               @relation("WinnerAnimeComparisons", fields: [winnerAnimeId], references: [id])
  loserAnime         Anime?               @relation("LoserAnimeComparisons", fields: [loserAnimeId], references: [id])

  @@unique([userId, clientMutationId])
  @@index([userId, poolId, runId])
  @@index([poolId, runId, createdAt])
  @@index([userId, poolId, runId, createdAt])
  @@index([userId, poolId, runId, undoneAt, createdAt])
  @@index([leftAnimeId])
  @@index([rightAnimeId])
  @@index([pairKey])
  @@index([createdAt])
  @@index([mode])
}

model UserAnimeStatus {
  id            String      @id @default(cuid())
  userId        String
  animeId       String
  status        WatchStatus @default(UNKNOWN)
  unseenCount   Int         @default(0)
  skipCount     Int         @default(0)
  source        String?
  firstMarkedAt DateTime    @default(now())
  lastMarkedAt  DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation("UserAnimeStatuses", fields: [userId], references: [id])
  anime         Anime       @relation("AnimeStatuses", fields: [animeId], references: [id])

  @@unique([userId, animeId])
  @@index([userId])
  @@index([animeId])
  @@index([status])
}

model ManualTierAdjustment {
  id                   String      @id @default(cuid())
  userId               String
  poolId               String
  runId                String
  animeId              String
  fromTier             String?
  toTier               String
  fromRank             Int?
  toRank               Int?
  eloScoreAtAdjustment Float
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation("UserTierAdjustments", fields: [userId], references: [id])
  pool                 CustomPool  @relation("PoolTierAdjustments", fields: [poolId], references: [id])
  run                  PersonalRun @relation("RunTierAdjustments", fields: [runId], references: [id])
  anime                Anime       @relation("AnimeTierAdjustments", fields: [animeId], references: [id])

  @@index([userId, poolId, runId])
  @@index([animeId])
}

model UserTagPreference {
  id        String       @id @default(cuid())
  userId    String
  poolId    String?
  runId     String?
  tag       String
  score     Float        @default(0)
  wins      Int          @default(0)
  losses    Int          @default(0)
  seenCount Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation("UserTagPreferences", fields: [userId], references: [id])
  pool      CustomPool?  @relation("PoolTagPreferences", fields: [poolId], references: [id])
  run       PersonalRun? @relation("RunTagPreferences", fields: [runId], references: [id])

  @@unique([userId, poolId, runId, tag])
  @@index([userId])
  @@index([tag])
}

model AnimeRecommendation {
  id         String                 @id @default(cuid())
  userId     String
  animeId    String
  score      Float
  reasonJson Json
  feedback   RecommendationFeedback @default(NONE)
  source     String                 @default("MIXED")
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation("UserAnimeRecommendations", fields: [userId], references: [id])
  anime      Anime                  @relation("AnimeRecommendations", fields: [animeId], references: [id])

  @@unique([userId, animeId])
  @@index([userId])
  @@index([score])
}

model UserSimilarity {
  id                      String   @id @default(cuid())
  userAId                 String
  userBId                 String
  scopeType               String   @default("GLOBAL")
  scopeId                 String?
  similarityScore         Float
  confidenceScore         Float
  commonAnimeCount        Int
  rankSimilarity          Float?
  tagSimilarity           Float?
  topAgreementAnimeIds    String[]
  topDisagreementAnimeIds String[]
  calculatedAt            DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  userA                   User     @relation("SimilarityUserA", fields: [userAId], references: [id])
  userB                   User     @relation("SimilarityUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId, scopeType, scopeId])
  @@index([userAId])
  @@index([userBId])
  @@index([similarityScore])
}

model RecalibrationSession {
  id             String                     @id @default(cuid())
  userId         String
  poolId         String
  runId          String
  type           RecalibrationSessionType
  status         RecalibrationSessionStatus @default(ACTIVE)
  targetTier     String?
  targetAnimeIds String[]
  plannedCount   Int
  completedCount Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([userId, poolId, runId])
  @@index([status])
}

enum BattleSeasonMode {
  CLASSIC
  BIAS
}

enum BattleSeasonStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum BattleVoteType {
  NORMAL
  BIAS
}

model BattleSeason {
  id                    String             @id @default(cuid())
  poolId                String
  pool                  CustomPool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  mode                  BattleSeasonMode   @default(CLASSIC)
  status                BattleSeasonStatus @default(DRAFT)
  startsAt              DateTime           @default(now())
  endsAt                DateTime?
  maxVotesPerUser       Int                @default(50)
  maxVotesPerUserPerDay Int?
  biasVotesPerUser      Int                @default(3)
  createdByUserId       String
  createdBy             User               @relation(fields: [createdByUserId], references: [id])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  votes      BattleVote[]
  userScores BattleSeasonUserScore[]

  @@index([poolId])
  @@index([status])
  @@index([createdByUserId])
}

model BattleVote {
  id                String         @id @default(cuid())
  seasonId          String
  season            BattleSeason   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  poolId            String
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  leftAnimeId       String
  rightAnimeId      String
  winnerAnimeId     String
  loserAnimeId      String
  voteType          BattleVoteType @default(NORMAL)
  weight            Int            @default(1)
  stepNumber        Int
  beforeWinnerScore Int            @default(0)
  afterWinnerScore  Int            @default(0)
  beforeLoserScore  Int            @default(0)
  afterLoserScore   Int            @default(0)
  beforeWinnerElo   Float?
  afterWinnerElo    Float?
  beforeLoserElo    Float?
  afterLoserElo     Float?
  createdAt         DateTime       @default(now())

  @@unique([seasonId, userId, stepNumber])
  @@index([seasonId, userId])
  @@index([seasonId, createdAt])
  @@index([poolId])
}

model BattleSeasonUserScore {
  id           String       @id @default(cuid())
  seasonId     String
  season       BattleSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  poolId       String
  pool         CustomPool   @relation("PoolBattleSeasonUserScores", fields: [poolId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  animeId      String
  anime        Anime        @relation("AnimeBattleSeasonUserScores", fields: [animeId], references: [id])
  eloScore     Float        @default(1500)
  uncertainty  Float        @default(350)
  compareCount Int          @default(0)
  winCount     Int          @default(0)
  lossCount    Int          @default(0)
  biasWinCount Int          @default(0)
  unseenCount  Int          @default(0)
  isHidden     Boolean      @default(false)
  lastVotedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([seasonId, userId, animeId])
  @@index([seasonId, userId])
  @@index([seasonId, animeId])
  @@index([poolId])
  @@index([userId])
  @@index([animeId])
  @@index([seasonId, eloScore])
}
